# Public URL of this instance. Used in magic links and share links.
# Session cookies get the Secure flag when this starts with https://.
APP_URL=http://localhost:3000
APP_PORT=3000

# Signs the guests' personal RSVP links. Set a long random value before you send links
# (openssl rand -base64 48) and keep it: changing it makes every link already sent stop working.
APP_SECRET=change-me

# Deleting guest data at the end of the RSVP package and the daily summary emails run inside the app
# every this many minutes (0 turns them off).
GUEST_JOBS_INTERVAL_MINUTES=15

# PostgreSQL (the bundled container). DATABASE_URL is derived from these in docker-compose.yml.
POSTGRES_USER=traureise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traureise
POSTGRES_PORT=5432

# SMTP for magic-link emails. Defaults point at the bundled Mailpit catcher (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Traureise <no-reply@traureise.localhost>
MAILPIT_UI_PORT=8025
# Address the Mailpit UI listens on. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to your LAN (development only).
MAILPIT_UI_BIND=127.0.0.1
MAILPIT_SMTP_PORT=1025

# File storage for uploaded images: "local" (Docker volume) or "s3" (any S3-compatible EU provider).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Source code of this instance, linked in the footer (AGPL-3.0 § 13). Change it if you run a modified version.
SOURCE_CODE_URL=https://github.com/Traureise/traureise

# Your own Impressum, privacy policy and terms as Markdown files (paths inside the container). Traureise ships none
# of the texts: who runs an instance and what it does with data differs for each one. Mount a folder, for example
# "./legal:/legal:ro" in docker-compose.yml, and point these at the files. Without a file the page (/impressum,
# /datenschutz, /agb) is a 404 and nothing links to it. Files are read on every request. Have them reviewed.
IMPRINT_FILE=
PRIVACY_FILE=
TERMS_FILE=

# Billing (paid tiers per wedding through Creem). Off by default: self-hosted instances never show
# prices or locks. It switches on only with BILLING_ENABLED=true and both Creem keys set.
BILLING_ENABLED=false
CREEM_API_URL=https://api.creem.io
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Creem product ids of the one-time products, one per tier.
CREEM_PRODUCT_RSVP=
CREEM_PRODUCT_INVITATIONS=
CREEM_PRODUCT_COMPLETE=
# Prices shown on /preise in whole euros, VAT included. Keep them equal to the Creem products.
PRICE_RSVP_EUR=49
PRICE_INVITATIONS_EUR=139
PRICE_COMPLETE_EUR=149
# Testing only: sells tiers whose features are not built yet (comma-separated). Never set in production.
BILLING_TEST_UNLOCK_TIERS=
