# Public URL of this instance. Used in magic links and share links.
# Session cookies get the Secure flag when this starts with https://.
APP_URL=http://localhost:3000
APP_PORT=3000

# PostgreSQL (the bundled container). DATABASE_URL is derived from these in docker-compose.yml.
POSTGRES_USER=traureise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traureise
POSTGRES_PORT=5432

# SMTP for magic-link emails. Defaults point at the bundled Mailpit catcher (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Traureise <no-reply@traureise.localhost>
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# File storage for uploaded images: "local" (Docker volume) or "s3" (any S3-compatible EU provider).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Source code of this instance, linked in the footer (AGPL-3.0 § 13). Change it if you run a modified version.
SOURCE_CODE_URL=https://github.com/Traureise/traureise

# Operator details for the Impressum (/impressum) and privacy policy (/datenschutz).
# NAME, ADDRESS and EMAIL are required; until they are set, both pages say they are not configured
# and the app logs a warning at startup. ADDRESS is comma-separated: "Straße 1, 12345 Ort, Deutschland".
# The generated texts are drafts: have your own legal texts reviewed before you go live.
OPERATOR_NAME=
OPERATOR_BUSINESS_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
# VAT: either your VAT ID, or a note such as the § 19 UStG small-business statement (or both).
OPERATOR_VAT_ID=
OPERATOR_VAT_NOTE=
# Person responsible for content under § 18 Abs. 2 MStV. Defaults to OPERATOR_NAME.
OPERATOR_CONTENT_RESPONSIBLE=
# Your consumer dispute-resolution statement (§ 36 VSBG), shown as written.
OPERATOR_DISPUTE_RESOLUTION=

# Processors named in the privacy policy, e.g. "Beispiel Hosting GmbH, Musterstraße 1, 12345 Ort".
# Left empty, the policy uses neutral wording.
PRIVACY_HOSTING_PROVIDER=
PRIVACY_SMTP_PROVIDER=
# Only used with STORAGE_DRIVER=s3.
PRIVACY_STORAGE_PROVIDER=

# Billing (paid tiers per wedding through Creem). Off by default: self-hosted instances never show
# prices or locks. It switches on only with BILLING_ENABLED=true and both Creem keys set.
BILLING_ENABLED=false
CREEM_API_URL=https://api.creem.io
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Creem product ids of the one-time products, one per tier.
CREEM_PRODUCT_RSVP=
CREEM_PRODUCT_INVITATIONS=
CREEM_PRODUCT_COMPLETE=
# Prices shown on /preise in whole euros, VAT included. Keep them equal to the Creem products.
PRICE_RSVP_EUR=49
PRICE_INVITATIONS_EUR=139
PRICE_COMPLETE_EUR=149
# Testing only: sells tiers whose features are not built yet (comma-separated). Never set in production.
BILLING_TEST_UNLOCK_TIERS=
